# Anawiser Environment Variables
# Copy this file to .env.local and fill in your values
# See docs/EXPLAINER.md for step-by-step setup instructions

# ── Bright Data Scraper Studio ──
# Get your API token from: Bright Data → Account Settings → API Tokens
BRIGHT_DATA_API_TOKEN=your_api_token_here

# Get your collector ID from: Scraper Studio → Your collector → Settings
# Format: c_lxxxxxxxxxx
BRIGHT_DATA_COLLECTOR_ID=your_collector_id_here

# ── Supabase Database ──
# Get these from: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
