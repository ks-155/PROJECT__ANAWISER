# Copy to .env.local for local dev.
# On Vercel: Project → Settings → Environment Variables
# Add every key below to Production, Preview, and Development.
# Never commit real tokens.

# Bright Data — public product pages only (Compare + collector + Self-Healing)
BRIGHT_DATA_API_TOKEN=
BRIGHT_DATA_COLLECTOR_ID=
BRIGHT_DATA_WEB_UNLOCKER_ZONE=

# Supabase — nearby shop quotes + retailer form on /local-admin
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini — AnawiserAI chat (GEMINI_API_KEY also works)
GEMINI_API_KEY=

# Optional. The 3D letters on Home are built into the app and do not need this.
NEXT_PUBLIC_SPLINE_SCENE_URL=

# Catalog photos ship in public/datasets (Vercel CDN).
# Optional second copy: npm run datasets:publish then paste the printed URL here.
NEXT_PUBLIC_DATASET_CDN=
# SUPABASE_SERVICE_ROLE_KEY=
# BLOB_READ_WRITE_TOKEN=
